# Менеджер массивов данных на Triton
вывод("📊 СИСТЕМА УПРАВЛЕНИЯ МАССИВАМИ 📊")

# Инициализация начального массива оценок
переменная оценки = массив_создать(4, 5, 3, 5, 2)
вывод("Начальный список оценок:")
вывод(оценки)

# Добавление новой оценки в конец
массив_добавить(оценки, 4)
вывод("\nДобавили оценку 4 в конец списка:")
вывод(оценки)

# Проверка на наличие двойки
вывод("\nПроверка: есть ли в списке неудовлетворительные оценки (2)?")
переменная есть_двойка = массив_включает(оценки, 2)
вывод("Ответ: " + в_строку(есть_двойка))

# Сортировка массива
массив_сортировать(оценки)
вывод("\nОценки, отсортированные по возрастанию:")
вывод(оценки)

# Разворот массива для получения оценок от лучших к худшим
массив_развернуть(оценки)
вывод("\nОценки, развернутые в обратном порядке (топ оценок):")
вывод(оценки)

вывод("\nВсего обработано оценок: " + в_строку(длина(оценки)))
