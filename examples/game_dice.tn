# Игра 'Кубики' на Triton
вывод("🎲 ЗАПУСК ИГРЫ 'КУБИКИ' 🎲")
вывод("ID Матча: " + айди_программы())
вывод("Время игры: " + дата_текст())
вывод("-----------------------------------")

# Броски кубиков для Игрока 1
переменная кубик1_игрок1 = случайно(1, 6)
переменная кубик2_игрок1 = случайно(1, 6)
переменная сумма_игрок1 = кубик1_игрок1 + кубик2_игрок1

вывод("Игрок 1 выбросил: " + в_строку(кубик1_игрок1) + " и " + в_строку(кубик2_игрок1))
вывод("Сумма Игрока 1: " + в_строку(сумма_игрок1))
вывод("-----------------------------------")

# Броски кубиков для Игрока 2
переменная кубик1_игрок2 = случайно(1, 6)
переменная кубик2_игрок2 = случайно(1, 6)
переменная сумма_игрок2 = кубик1_игрок2 + кубик2_игрок2

вывод("Игрок 2 выбросил: " + в_строку(кубик1_игрок2) + " и " + в_строку(кубик2_игрок2))
вывод("Сумма Игрока 2: " + в_строку(сумма_игрок2))
вывод("-----------------------------------")

# Определение максимального результата
переменная лучший_результат = макс(сумма_игрок1, сумма_игрок2)
вывод("Наивысший балл в этом раунде: " + в_строку(лучший_результат))

# Логика определения победителя
если (сумма_игрок1 == сумма_игрок2) {
    вывод("🤖 Результат: Ничья! Оба игрока равны.")
}
иначе если (сумма_игрок1 > сумма_игрок2) {
    вывод("🏆 Результат: Победил Игрок 1!")
}
иначе {
    вывод("🏆 Результат: Победил Игрок 2!")
}
