# Тестирование математического модуля Triton
вывод("=== Тест математики ===")
переменная радиус = 10
переменная площадь = пи() * степень(радиус, 2)
вывод("Площадь круга с радиусом 10 равна: " + в_строку(площадь))

переменная куб = степень(случайно(1, 5), 3)
вывод("Куб случайного числа: " + в_строку(куб))
