# Анализатор текста на языке Triton
вывод("=== АНАЛИЗАТОР СТРОК v1.0 ===")

переменная исходный_текст = "  Язык Программирования Triton от Timer-Community!  "
переменная чистый_текст = убрать_пробелы(исходный_текст)

вывод("1. Текст без лишних пробелов по краям:")
вывод(чистый_текст)

вывод("\n2. Длина очищенного текста:")
вывод(в_строку(длина(чистый_текст)) + " символов")

вывод("\n3. Проверка на содержание ключевого слова 'Triton':")
если (содержит(чистый_текст, "Triton")) {
    вывод("Результат: Слово найдено в тексте!")
}

вывод("\n4. Текст, переведенный в КРИК (аппер):")
вывод(аппер(чистый_текст))

вывод("\n5. Разделение текста на массив по пробелам:")
переменная слова = разбить(чистый_текст, " ")
вывод(слова)
